# Local-only development credentials. Copy this file to .env before starting.
MINIO_ROOT_USER=minio-local-admin
MINIO_ROOT_PASSWORD=change-this-local-password

# Host ports; container-to-container addresses remain stable inside Compose.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
